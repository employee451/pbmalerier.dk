<!DOCTYPE html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body {{ background_color ? `style="background-color: ${background_color}"` : "" }}>
    <a href="/">
      <img src="/flower.svg" role="img" alt="Flower" class="flower" />
    </a>
    {{ content }}
    <img src="/flower.svg" role="img" alt="Flower" class="flower" />
    <div class="footer">
      <p class="footer-text">{{ sitetitle }} {{ new Date().getFullYear() }}</p>
    </div>
  </body>
</html>