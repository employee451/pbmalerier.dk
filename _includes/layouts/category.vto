---
layout: layouts/main.vto
---
<ul class="breadcrumbs">
  <li>
    <a href="/">{{ sitetitle }}</a>
  </li>
  <li>
    {{ title }}
  </li>
</ul>

<h1 class="maintitle">{{ title }}</h1>
{{ if content }}
<div class="page-description">{{ content }}</div>
{{ /if }}

<ul class="painting-list">
{{ for file_name of paintings }}

  {{ set painting_result = search.pages("type=painting").find(p => p.page.src.path + p.page.src.ext === "/billeder/" + file_name) }}

  {{ if painting_result }}
  <li>
    <a href="{{ painting_result.url }}">
      <img src="{{ painting_result.painting }}" alt="{{ painting_result.title || 'Maleri' }}" transform-images="avif webp jpg 800@2" />
      <h2>{{ painting_result.title }}</h2>
    </a>
  </li>
  {{ /if }}
  
{{ /for }}
</ul>